{
  "info": {
    "_postman_id": "9f2601c5-20cc-4db5-9d88-b2bpriceimport01",
    "name": "B2B Price Import",
    "description": "Upload a CSV file and start its import as two separate requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://b2b-mriya.dev/"
    },
    {
      "key": "access_key",
      "value": "346981c426a0906870c52d8ccc470e9b194e44f1bece06f0cc801c0321a9af1a"
    },
    {
      "key": "stored_filename",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Upload CSV file",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "description": "Choose a local .csv file in Postman.",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": "{{base_url}}/module/b2bpriceimport/upload?key={{access_key}}",
        "description": "Stores the CSV file on the server. This request does not create or run an import."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('Upload succeeded', function () {",
              "    pm.expect(response.success).to.eql(true);",
              "    pm.expect(response.file.stored_filename).to.be.a('string').and.not.empty;",
              "});",
              "",
              "if (response.success && response.file && response.file.stored_filename) {",
              "    pm.collectionVariables.set('stored_filename', response.file.stored_filename);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Run uploaded CSV file",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/module/b2bpriceimport/import?key={{access_key}}&file={{stored_filename}}",
        "description": "Starts the import for the stored_filename returned by the upload request."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP request completed successfully', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 409]);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('Response contains import status', function () {",
              "    pm.expect(response).to.have.property('success');",
              "    pm.expect(response).to.have.property('message');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
